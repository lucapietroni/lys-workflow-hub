# =============================================================================
# Template di configurazione per LYS Workflow Hub.
#
# Copia questo file in .env (stessa cartella) e compila i valori.
# IL FILE .env NON DEVE MAI ESSERE COMMITTATO (è gia' in .gitignore).
# =============================================================================

# --- WinCar ----------------------------------------------------------------
# Percorso assoluto alla cartella Archivio di WinCar (contenente i .mdb)
WINCAR_ARCHIVIO=C:\Users\lucap\OneDrive\Documenti\Claude\Projects\Lysauto\wincar-sample\Archivi

# Connessione ODBC: nome del driver Microsoft Access installato
WINCAR_ODBC_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)

# --- App ------------------------------------------------------------------
# Host e porta su cui il web server sara' in ascolto
APP_HOST=0.0.0.0
APP_PORT=8000

# Modalita' di esecuzione: development | production
APP_ENV=development

# Cartella dove l'app salva le cessioni firmate (archivio centrale)
APP_ARCHIVIO_CESSIONI=C:\LYSApp\Cessioni_firmate

# Percorso del DB SQLite interno (anagrafica compagnie e altri metadati).
# Default: data/lys_hub.db (relativo alla radice del progetto).
APP_DB_PATH=data/lys_hub.db

# File di log con rotazione (5 MB x 5 backup). Cartella creata automaticamente.
# Indispensabile in produzione con pythonw.exe (niente console disponibile).
APP_LOG_PATH=C:\LYSApp\logs\lys-hub.log
APP_LOG_LEVEL=INFO

# --- Carrozzeria (intestazioni e contatti per PEC vandalismo) -------------
# Indirizzo PEC e contatti che vengono inseriti in fondo al corpo PEC come
# riferimento per le risposte delle compagnie.
CARROZZERIA_PEC=
CARROZZERIA_EMAIL=
CARROZZERIA_TELEFONO=
# Nome del legale rappresentante o referente che firma la bozza PEC.
CARROZZERIA_REFERENTE=

# --- Posta in entrata (M3 - non usato in M1) ------------------------------
# PEC Legalmail (InfoCert)
PEC_IMAP_HOST=mbox.cert.legalmail.it
PEC_IMAP_PORT=993
PEC_USER=tua.casella@legalmail.it
PEC_PASSWORD=

# Email ordinaria su Tophost
EMAIL_IMAP_HOST=mail.tophost.it
EMAIL_IMAP_PORT=993
EMAIL_USER=amministrazione@lysauto.it
EMAIL_PASSWORD=

# Polling delle caselle in minuti
MAIL_POLL_INTERVAL_MIN=5

# Filtro data per il fetcher IMAP (M3).
# Se valorizzato (YYYY-MM-DD), il fetcher scarica SOLO le email ricevute dal
# server in quella data in poi. Indispensabile al primo deploy per evitare
# di processare l'intero archivio storico della casella PEC (e accumulare
# costi AI). Esempio: 2026-05-15 = solo email dal 15 maggio 2026 in poi.
# Vuoto = nessun filtro (scarica tutto secondo la logica UID).
MAIL_FETCH_SINCE=2026-05-15

# --- Posta in uscita (M2 - non usato in M1) -------------------------------
# IMPORTANTE Tophost: l'SMTP autenticato e' su smtp.<tuo-dominio> (es.
# smtp.lysauto.it), NON su mail.tophost.it. Quest'ultimo accetta IMAP/POP3
# ma rifiuta l'autenticazione SMTP con 535 5.7.8.
# Username = email completa (es. amministrazione@lysauto.it), non solo "amministrazione".
SMTP_HOST=smtp.lysauto.it
SMTP_PORT=587
SMTP_USER=amministrazione@lysauto.it
SMTP_PASSWORD=

# From address dell'email riassuntiva. Vuoto = usa SMTP_USER.
SMTP_FROM=amministrazione@lysauto.it

# Modalita' di cifratura SMTP:
#   starttls = porta 587 con upgrade STARTTLS (default Tophost)
#   ssl      = porta 465 con SMTPS implicito
#   none     = nessuna cifratura (sconsigliato)
# Vuoto = scelta automatica in base alla porta (465 -> ssl, altrimenti starttls).
SMTP_TLS=starttls

PEC_SMTP_HOST=sendm.cert.legalmail.it
PEC_SMTP_PORT=465
PEC_SMTP_USER=tua.casella@legalmail.it
PEC_SMTP_PASSWORD=

# Modalità dry-run: se true, l'app NON apre connessione SMTP. Genera comunque
# il file .eml + record DB con esito DRY_RUN. Utile per testare in sviluppo
# senza inviare PEC reali alle compagnie. In produzione lasciare false.
PEC_DRY_RUN=false

# Cartella centrale dove archiviare i file .eml delle PEC inviate
# (partizionata per anno, sottocartella creata automaticamente al primo invio).
APP_ARCHIVIO_PEC=C:\LYSApp\PEC_inviate

# Display name del mittente PEC ("From: <alias> <pec>"). Se vuoto, viene
# usata la ragione sociale standard della carrozzeria.
CARROZZERIA_PEC_ALIAS=Carrozzeria LYS Auto srl

# --- AI / Claude API (M3) -------------------------------------------------
# Se true, il classificatore NON chiama l'API: ogni mail viene marcata
# come "altro" con confidence 0. Utile per testare il flusso senza budget.
AI_DISABLED=false
ANTHROPIC_API_KEY=
# Modello consigliato per il caso d'uso: claude-haiku-4-5 (veloce, economico).
# Per casi difficili si può passare a claude-sonnet-4-6 (più caro).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Modello per lettura targhe da foto lavorazioni (v2.1). Serve più capacità
# OCR/vision di Haiku, specie su foto di taglio o angolate. Costo per foto
# trascurabile: lasciare claude-sonnet-5 salvo problemi di budget.
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Tetto di spesa mensile in EUR. L'app NON blocca l'invio in automatico
# (per non interrompere il workflow), ma logga un WARN quando si supera
# AI_BUDGET_ALERT_EUR. Resta tua responsabilità monitorare.
AI_BUDGET_MONTHLY_EUR=20
AI_BUDGET_ALERT_EUR=15

# --- Foto lavorazioni (v2.1) -----------------------------------------------
# Cartella dove Syncthing deposita le foto dallo smartphone aziendale.
# Il watcher elabora ogni nuova immagine: Claude Vision estrae la targa,
# copia la foto in FOTO_FALLBACK_PATH/<TARGA>/ e (se pratica trovata) anche
# in WinCar Pratiche/<n>/Pubblici/Foto/.
#
# IMPORTANTE: lasciare vuoto (o commentato) in sviluppo — il watcher non parte.
# In produzione impostare il percorso reale dopo aver configurato Syncthing.
#
# Setup Syncthing:
#   1. Installare Syncthing su smartphone Android e su questo PC
#   2. Configurare cartella sync: [fotocamera Android] → [FOTO_INBOX_PATH]
#   3. Riavviare il servizio LYS Hub dopo aver impostato questa variabile
FOTO_INBOX_PATH=
# FOTO_INBOX_PATH=C:\LYSApp\Inbox Foto   ← decommentare in produzione

# Archivio permanente per targa. Sempre popolato, anche senza pratica WinCar.
# Struttura: FOTO_FALLBACK_PATH\<TARGA>\<timestamp>_<uuid>_<nome-originale>
FOTO_FALLBACK_PATH=C:\LYSApp\Foto lavorazioni

# --- SLA pratiche (M5/M6.1) -------------------------------------------------
# Numero di giorni senza risposta dopo i quali scatta l'alert SLA (push ntfy).
# Impostare a 0 per disabilitare il check SLA.
SLA_GIORNI_ALERT=15
# Escalation automatica (M6.1): soglie per sollecito formale e diffida.
# Al raggiungimento di ogni soglia viene generata una bozza PEC in /bozze
# con il testo appropriato. Impostare a 0 per disabilitare quel livello.
SLA_FORMALE_GIORNI=30
SLA_DIFFIDA_GIORNI=45

# --- PDF extraction (M5.3) ---------------------------------------------------
# Se true, il fetcher IMAP estrae il testo dagli allegati PDF delle risposte
# assicurative quando il corpo della mail è corto/vuoto. Richiede pypdf>=4.0
# (installato automaticamente con requirements.txt).
PDF_EXTRACT_ENABLED=true
# Soglia in caratteri: l'estrazione PDF scatta solo se body_text < questo valore.
# Con 200 lascia passare email con corpo sufficiente, estrae solo per quelle
# tipo "Si veda l'allegato" o con corpo vuoto.
PDF_EXTRACT_MIN_BODY_LEN=200

# Cartella centrale dove archiviare le .eml ricevute, partizionate per anno.
APP_ARCHIVIO_MAIL_IN=C:\LYSApp\Mail_in

# --- Notifiche (M3) -------------------------------------------------------
# Se true, niente push e niente email riassuntiva (modalità silenziosa).
NOTIFY_DISABLED=false

# Topic ntfy.sh segreto. Generalo con un suffisso random difficile da indovinare
# (es. 'lys-alerts-9f3a82b1c4d5e6'). Aggiungilo all'app ntfy sul tuo smartphone
# per ricevere le push. Vuoto = niente push (l'email riassuntiva resta attiva).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Email destinataria del riepilogo dopo ogni ciclo di polling.
# Vuoto = niente email riassuntiva.
ALERT_EMAIL=luca.pietroni@gmail.com

# --- Autenticazione (v3.0) -------------------------------------------------
# Chiave di firma del cookie di sessione. OBBLIGATORIA se APP_ENV=production
# (l'app si rifiuta di partire senza). Genera con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In sviluppo puoi lasciarla vuota: viene generata una chiave effimera ad
# ogni avvio (comodo, ma perdi la sessione ad ogni riavvio/reload).
SECRET_KEY=

# Durata cookie di sessione (giorni) prima di dover rifare login.
SESSION_MAX_AGE_DAYS=14

# Tentativi di login falliti consecutivi prima del blocco temporaneo account.
LOGIN_MAX_ATTEMPTS=5
# Durata del blocco (minuti).
LOGIN_LOCKOUT_MINUTES=15

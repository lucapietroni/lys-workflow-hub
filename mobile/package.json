{
  "name": "lys-workflow-hub-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Wrapper Capacitor Android del portale esterno LYS Workflow Hub. server.url in capacitor.config.json deve combaciare con PUBLIC_BASE_URL (.env del backend Python) — se cambia, aggiornare qui e ricompilare l'APK.",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capgo/capacitor-native-biometric": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0"
  }
}
